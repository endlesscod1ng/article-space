{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./build",
    "noImplicitAny": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "jsx": "react-jsx",
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    // "paths": {
    //   "@/*": ["./src/*"]
    // }
  },
  "include": ["src/**/*", "global.d.ts"],
  "exclude": ["node_modules"],
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS"
    }
  }
}
